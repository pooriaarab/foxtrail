{
  "manifest_version": 3,
  "name": "foxtrail demo",
  "version": "0.1.0",
  "description": "A tamper-evident audit log for AI agent actions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxtrail@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "foxtrail demo",
    "default_popup": "popup.html"
  }
}
