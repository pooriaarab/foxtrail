{
  "manifest_version": 3,
  "name": "foxtrail — tamper-evident log for AI agents",
  "version": "0.1.3",
  "description": "A tamper-evident audit log for AI agent actions.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxtrail@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "foxtrail",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_popup": "popup.html"
  }
}
